# Python
**/.venv/
**/__pycache__/
**/.pytest_cache/
*.pyc
# Node
**/node_modules/
**/dist/
# Local secrets / generated data
**/.env
**/.env.local
**/*.sqlite
**/*.sqlite-journal
# OS / editor
.DS_Store
.vscode/

# Local agent backups
backend/app/*.bak

# TypeScript incremental build artifacts
**/*.tsbuildinfo

# Public release safeguards
**/.env.*
!**/.env.example
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/*.db-wal
**/*.db-shm
**/*.log
**/.coverage
backend/evals/results/*
!backend/evals/results/.gitignore

# Disposable local demo sandboxes, never commit live data or tokens
.demo_runs/
